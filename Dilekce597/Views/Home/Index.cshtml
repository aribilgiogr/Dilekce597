@model IEnumerable<FeedbackListItemViewModel>
@{
    ViewData["Title"] = "Şikayet ve Görüş Listesi";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>@ViewData["Title"]</h2>
    <a asp-action="create" asp-controller="home" class="btn btn-primary">
        Yeni Bildirim Oluştur
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Id)</th>
                        <th>@Html.DisplayNameFor(model => model.FullName)</th>
                        <th>@Html.DisplayNameFor(model => model.Category)</th>
                        <th>@Html.DisplayNameFor(model => model.CreatedAt)</th>
                        <th class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="align-middle">@item.Id</td>
                                <td class="align-middle">@item.FullName</td>
                                <td class="align-middle">
                                    <span class="badge bg-secondary">
                                        @Html.DisplayFor(modelItem => item.Category)
                                    </span>
                                </td>
                                <td class="align-middle">@item.CreatedAt.ToLongDateString() @item.CreatedAt.ToLongTimeString()</td>
                                <td class="align-middle text-end pe-4">
                                    <a asp-action="detail" asp-controller="home" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">
                                        Detay Gör
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                <h6>Henüz kayıtlı bir şükayet veya görüş bulunmamaktadır.</h6>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>