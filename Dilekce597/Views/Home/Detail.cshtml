@model FeedbackDetailViewModel
@{
    ViewData["Title"] = "Bildirim Detayı - #" + Model.Id;
}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>@ViewData["Title"]</h2>
            <a asp-action="index" asp-controller="home" class="btn btn-outline-secondary">
                Listeye Dön
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-light py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Kayıt Bilgileri</h5>
                    <span class="badge bg-primary fs-6">
                        @Html.DisplayFor(model => model.Category)
                    </span>
                </div>
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.FullName)</dt>
                    <dd class="col-sm-8 font-semibold">@Model.FullName</dd>

                    <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Email)</dt>
                    <dd class="col-sm-8 font-semibold">
                        <a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a>
                    </dd>

                    <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.CreatedAt)</dt>
                    <dd class="col-sm-8 font-semibold">
                        @Model.CreatedAt.ToLongDateString() @Model.CreatedAt.ToLongTimeString()
                    </dd>

                    <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Message)</dt>
                    <dd class="col-sm-8 font-semibold">@Model.Message</dd>
                </dl>
            </div>
        </div>
    </div>
</div>